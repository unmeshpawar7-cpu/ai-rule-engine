{
  "ConnectionStrings": {
    "RuleEngine": "Server=localhost,1433;Database=RuleEngine;User Id=sa;Password=CHANGE_ME;TrustServerCertificate=True"
  },
  "Database": {
    "ApplyMigrationsOnStartup": false,
    "EnsureCreatedOnStartup": false
  },
  "Jwt": {
    "Issuer": "ai-rule-engine",
    "Audience": "ai-rule-engine-clients",
    "SigningKey": "",
    "AccessTokenMinutes": 60
  },
  "RuleEngine": {
    "RequirePassingTestsToPublish": true,
    "MaxConditionDepth": 10,
    "MaxConditionNodes": 200,
    "RegexTimeoutMs": 100,
    "MaxRegexLength": 256,
    "MaxActionsPerRule": 20,
    "ActionMaxAttempts": 3,
    "ActionBaseDelayMs": 200,
    "ActionMaxDelayMs": 5000
  },
  "RateLimiting": {
    "GenerationPermitsPerMinute": 10
  },
  "Llm": {
    "Provider": "offline",
    "TimeoutSeconds": 60,
    "MaxAttempts": 2
  },
  "Webhooks": {
    "TimeoutSeconds": 10,
    "NotificationChannels": {},
    "Workflows": {}
  },
  "DemoUsers": {
    "Enabled": false,
    "Users": []
  },
  "Swagger": {
    "Enabled": false
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatter": "Serilog.Formatting.Compact.RenderedCompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "AllowedHosts": "*"
}
