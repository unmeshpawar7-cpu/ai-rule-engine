# Copy to .env (git-ignored) and replace every value.
MSSQL_SA_PASSWORD=Replace_with_a_Str0ng_password
JWT_SIGNING_KEY=replace-with-a-random-secret-of-at-least-32-characters
# Development seeds the demo users from appsettings.Development.json; use Production for anything shared.
ASPNETCORE_ENVIRONMENT=Development

# AI rule generation: offline (deterministic grammar only) | openai | anthropic
LLM_PROVIDER=offline
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
